{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "sgj-live",
  "framework": null,
  "buildCommand": "npm run build",
  "regions": ["bom1"],
  "git": {
    "deploymentEnabled": true
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sadhgurugemsandjewellers.com" }],
      "destination": "https://www.sadhgurugemsandjewellers.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self)" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "private, no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "private, no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/owner",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "private, no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/owner/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "private, no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/account",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "private, no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/login",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/cart",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/checkout",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=31536000, immutable" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=31536000, immutable" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff2|webp|jpg|jpeg|png|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=31536000, immutable" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=120, stale-while-revalidate=86400, stale-if-error=86400" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=120, stale-while-revalidate=86400, stale-if-error=86400" }
      ]
    },
    {
      "source": "/shop",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=120, stale-while-revalidate=86400, stale-if-error=86400" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=120, stale-while-revalidate=86400, stale-if-error=86400" }
      ]
    },
    {
      "source": "/shop/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=120, stale-while-revalidate=86400, stale-if-error=86400" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=120, stale-while-revalidate=86400, stale-if-error=86400" }
      ]
    },
    {
      "source": "/gemstones",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=86400, stale-if-error=86400" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=86400, stale-if-error=86400" }
      ]
    },
    {
      "source": "/gemstones/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=86400, stale-if-error=86400" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=86400, stale-if-error=86400" }
      ]
    },
    {
      "source": "/(navratna|about|contact|why-us|history|careers|reviews|astrology|colours|brass|copper|shipping|enquire|privacy|track)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=86400, stale-if-error=86400" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=86400, stale-if-error=86400" }
      ]
    }
  ]
}
